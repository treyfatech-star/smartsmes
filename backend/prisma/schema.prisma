generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum VatCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum SubscriptionTier {
  FREE
  SME
  ACCOUNTANT
}

model Tenant {
  id                  String         @id @default(cuid())
  name                String
  tin                 String         @unique
  vatNumber           String?        @unique
  address             String
  email               String
  phone               String?
  country             String         @default("NG")
  currency            String         @default("NGN")
  invoiceSequence     Int            @default(0)
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  users               User[]
  customers           Customer[]
  vendors             Vendor[]
  invoices            Invoice[]
  expenses            Expense[]
  vatRecords          VATRecord[]
  auditLogs           AuditLog[]
  subscriptions       Subscription[]

  @@index([name])
}

model User {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  email               String
  fullName            String
  passwordHash        String
  role                Role
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String
  auditLogs           AuditLog[]
  invoicesCreated     Invoice[]      @relation("InvoiceCreatedBy")
  expensesCreated     Expense[]      @relation("ExpenseCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Subscription {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  tier                SubscriptionTier
  invoicesLimit       Int?
  priceKobo           Int
  status              String
  stripeCustomerId    String?
  stripeSubscriptionId String?
  startDate           DateTime
  endDate             DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdBy           String

  @@index([tenantId, tier])
}

model Customer {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  name                String
  email               String?
  phone               String?
  tin                 String?
  address             String?
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String
  invoices            Invoice[]

  @@index([tenantId, name])
}

model Vendor {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  name                String
  email               String?
  phone               String?
  tin                 String?
  address             String?
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String
  expenses            Expense[]

  @@index([tenantId, name])
}

model Invoice {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id])
  invoiceNumber       String
  issueDate           DateTime
  dueDate             DateTime?
  status              InvoiceStatus
  subtotalKobo        Int
  outputVatKobo       Int
  totalKobo           Int
  notes               String?
  nrsPayload          Json
  paidAt              DateTime?
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String
  createdByUserId     String
  createdByUser       User           @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  invoiceItems        InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issueDate])
  @@index([tenantId, status])
}

model InvoiceItem {
  id                  String         @id @default(cuid())
  invoiceId           String
  invoice             Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description         String
  quantity            Decimal        @db.Decimal(12, 2)
  unitPriceKobo       Int
  vatCategory         VatCategory
  vatRate             Decimal        @db.Decimal(5, 4)
  taxableAmountKobo   Int
  vatAmountKobo       Int
  lineTotalKobo       Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String

  @@index([invoiceId])
}

model Expense {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  vendorId            String?
  vendor              Vendor?        @relation(fields: [vendorId], references: [id])
  category            String
  description         String
  expenseDate         DateTime
  grossAmountKobo     Int
  vatCategory         VatCategory
  inputVatKobo        Int
  netAmountKobo       Int
  reference           String?
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String
  createdByUserId     String
  createdByUser       User           @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
}

model VATRecord {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  period              String
  outputVatKobo       Int
  inputVatKobo        Int
  netVatPayableKobo   Int
  transactionCount    Int
  generatedAt         DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String

  @@unique([tenantId, period])
  @@index([tenantId, period])
}

model AuditLog {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  action              String
  entityType          String
  entityId            String
  metadata            Json
  immutableHash       String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}
